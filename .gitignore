node_modules/
api-keys.json
oc-workspace/
*.log
.env
free_models.json
# The salt the device fingerprint is derived with — per installation, and the
# fingerprint has to stay the same across rebuilds.
identity.salt

# Local notes and tooling state, not part of the project.
#
# docs/ 下只有 docs/reference/ 入库：那是长期可查的设计、上游协议与流程文档。
# 其余（任务书、会话日志、一次性报告）留本机 —— 它们带真实账号 id、本机路径，
# 或者只在当时有意义。新文档放进 docs/reference/ 之前先过脱敏。
/docs/*
!/docs/reference

# 第三方 skill 自带的 docs（原先被 docs/ 那条一起带住了，保持原样）
.agents/skills/**/docs/
.cortexkit/
problem.md

# Material from reversing the Qoder client: the decrypted catalogue carries
# the account's own model list, and the captured requests are the account's
# traffic. Both stay on this machine.
reference/qoder/

# Helpers for the machine this runs on, not for the service: they rewrite
# personal client configs and poke at the opencode client's own storage.
tools/

# The panel's dependencies and build output
web/node_modules/
web/dist/

# The IDE's own files: they carry this machine's paths.
.idea/

# 这台机器专用的 mise 任务
mise.local.toml

# Python
__pycache__/
*.pyc
# 冒烟测试的日志目录（smoke.sh 建的）
test/.smoke-logs/
test/.tmp/

# 面板的 e2e 套件（`mise run test:panel:e2e`）跑出来的东西：报告、trace、截图、
# 本地网关实例的日志，以及这一次运行的数据目录路径。截图与 trace 里可能有账号
# 标识，一律不入库。
.e2e/
# `e2e init` 会写的东西：skill（九个文件）与给 Claude Code 的软链。面板的用例
# 是我们自己写在 `tests/` 下的，这两样不进仓库（`.agents/skills/` 下别的 skill
# 是仓库里的东西，只挡 e2e 这一个）。
.claude/
.agents/skills/e2e/
